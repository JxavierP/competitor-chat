package components

templ ChatMessage(role string, content string, id string) {
	if role == "user" {
		<div data-on-load="@get('/chat')" class="flex justify-self-end my-10 bg-rose-pine-highlight-med text-white p-3 rounded-lg max-w-xs">
			{ content }
		</div>
	} else if role == "assistant" {
		<div id={ id } class="flex flex-col prose prose-sm text-[1rem] prose-pine justify-self-start my-10 text-rose-pine-text rounded-lg max-w-full">
			@templ.Raw(content)
		</div>
	}
}

templ ChatArea() {
	<div class="flex flex-col w-full h-full grow-0 px-[13rem] overflow-y-auto">
		<div id="chat-messages" class="w-full text-[#f6f6f6]"></div>
	</div>
}
