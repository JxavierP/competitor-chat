package components

templ ChatMessage(role string, content string, id string) {
	if role == "user" {
		<div data-on-load="@get('/chat')" data-scroll-into-view__smooth class="flex justify-self-end my-10 bg-rose-pine-highlight-med text-white p-3 rounded-lg max-w-xs">
			{ content }
		</div>
	} else if role == "assistant" {
		<div id={ id } class="flex max-w-3xl flex-col prose prose-sm text-[1rem] prose-pine justify-self-start my-10 text-rose-pine-text rounded-lg">
			@templ.Raw(content)
		</div>
	}
}

templ ChatArea() {
	<div class="flex-1 w-full overflow-y-auto">
		<div id="chat-messages" class="max-w-3xl mx-auto w-full text-[#f6f6f6]"></div>
	</div>
}
